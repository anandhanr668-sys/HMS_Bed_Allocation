beds = Bed_Master[Bed_Type == input.Required_Bed && Bed_Status == "Free"];

if(beds.count() > 0)
{
    bed = beds.get(0);
    input.Assigned_Bed_ID = bed.Bed_ID;
    input.Patient_Status = "Admitted";
    input.Admission_Time = zoho.currenttime;
    bed.Bed_Status = "Occupied";
}
else
{
    input.Patient_Status = "Waiting";

    insert into Waiting_List
    [
        Patient_ID = input.Patient_ID
        Required_Bed = input.Required_Bed
        Priority = "High"
        Waiting_Since = zoho.currenttime
    ];
}
