if(input.Approval_Status == "Pending" && input.Delay_Hours > 2)
{
    patient = Patient_Registration[Patient_ID == input.Patient_ID];
    bed = Bed_Master[Bed_ID == patient.Assigned_Bed_ID];

    if(bed != null)
    {
        bed.Bed_Status = "Free";
    }

    patient.Patient_Status = "Waiting";
    patient.Assigned_Bed_ID = null;
}
