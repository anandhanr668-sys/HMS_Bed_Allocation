if(input.Bed_Status == "Free")
{
    waiting = Waiting_List[Required_Bed == input.Bed_Type]
              .sort("Waiting_Since","asc");

    if(waiting.count() > 0)
    {
        nextPatient =
        Patient_Registration[Patient_ID == waiting.get(0).Patient_ID];

        nextPatient.Assigned_Bed_ID = input.Bed_ID;
        nextPatient.Patient_Status = "Admitted";

        input.Bed_Status = "Occupied";
        delete Waiting_List[Patient_ID == nextPatient.Patient_ID];
    }
}
